# ==============================================================================
# Yemen Micro-tasks (كسب اليمن) - Production & Vercel Environment Variables
# Copy these into your Vercel Project Settings -> Environment Variables
# ==============================================================================

# Supabase Public API Credentials (Required by Vite Frontend & Backend)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional Server-Side Privileged Key for Automated Admin Actions
# When supplied in Vercel/Server, it enables privileged atomic RPCs and admin tasks.
# NEVER expose this key to the browser or prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Primary Authorized Administrator Email
ADMIN_EMAIL="khalidalbuhiri97@gmail.com"
ADMIN_INITIAL_PASSWORD="YourSecurePasswordHere!"

# Optional AI Studio / Gemini API Key
GEMINI_API_KEY="your-gemini-api-key"

# ClixWall Offer Wall & Postback Configuration
CLIXWALL_API_KEY="your-clixwall-api-key"
CLIXWALL_POSTBACK_SECRET="your-clixwall-postback-secret"
CLIXWALL_OFFERWALL_URL="https://clixwall.com/wall"

# Web Push (VAPID) Configuration for Background Browser & Android Notifications
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@kasbyemen.com"

# YT Coin Verified Ad Networks S2S Postback Secret (Never prefix with VITE_)
YT_COIN_AD_POSTBACK_SECRET=""

# Offerwall.GG Server-Side Signing & Postback Verification Secret (Never prefix with VITE_)
OFFERWALL_GG_SECRET=
OFFERWALL_GG_PUBLIC_KEY=""
