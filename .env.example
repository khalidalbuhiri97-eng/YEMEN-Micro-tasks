# ==============================================================================
# Yemen Micro-tasks (كسب اليمن) - Production & Vercel Environment Variables
# Copy these into your Vercel Project Settings -> Environment Variables
# ==============================================================================

# Supabase Public API Credentials (Required by Vite Frontend & Backend)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional Server-Side Privileged Key for Automated Admin Actions
# When supplied in Vercel/Server, it enables privileged atomic RPCs and admin tasks.
# NEVER expose this key to the browser or prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Primary Authorized Administrator Email
ADMIN_EMAIL="khalidalbuhiri97@gmail.com"
ADMIN_INITIAL_PASSWORD="YourSecurePasswordHere!"

# Optional AI Studio / Gemini API Key
GEMINI_API_KEY="your-gemini-api-key"

